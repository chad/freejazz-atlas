[Unit]
Description=The Free Jazz Atlas web app
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/boxd/freejazz-atlas
ExecStart=/home/boxd/freejazz-atlas/.venv/bin/uvicorn web.server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=2
User=boxd

[Install]
WantedBy=multi-user.target
